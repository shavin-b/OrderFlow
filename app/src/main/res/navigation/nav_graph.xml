<?xml version="1.0" encoding="utf-8"?>
<!--
    NAVIGATION GRAPH
    Defines all fragment destinations for the HomeActivity's NavHostFragment.

    Key rules:
    - startDestination: which fragment appears first when HomeActivity opens (Dashboard)
    - Each fragment's android:id must match the corresponding menu item ID in bottom_nav_menu.xml
    - Top-level destinations (in the bottom nav) have no "popUpTo" behavior needed —
      NavigationUI handles them as top-level destinations automatically

    In future phases:
    - Additional destinations (e.g., AddKeywordFragment, EditReplyFragment) will be added here
    - Actions/transitions between destinations will be defined with <action> tags
-->
<navigation
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/dashboardFragment">

    <!-- Dashboard: home screen, shown first -->
    <fragment
        android:id="@+id/dashboardFragment"
        android:name="com.orderflow.ui.dashboard.DashboardFragment"
        android:label="@string/nav_dashboard" />

    <!-- Keywords: manage auto-reply trigger rules -->
    <fragment
        android:id="@+id/keywordsFragment"
        android:name="com.orderflow.ui.keywords.KeywordsFragment"
        android:label="@string/nav_keywords" />

    <!-- Replies: manage reply templates -->
    <fragment
        android:id="@+id/repliesFragment"
        android:name="com.orderflow.ui.replies.RepliesFragment"
        android:label="@string/nav_replies" />

    <!-- Logs: activity log of all processed messages -->
    <fragment
        android:id="@+id/logsFragment"
        android:name="com.orderflow.ui.logs.LogsFragment"
        android:label="@string/nav_logs" />

    <!-- Settings: app configuration -->
    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.orderflow.ui.settings.SettingsFragment"
        android:label="@string/nav_settings" />

</navigation>
