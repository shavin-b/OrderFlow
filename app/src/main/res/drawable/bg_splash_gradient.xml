<?xml version="1.0" encoding="utf-8"?>
<!--
    SPLASH / LOGIN GRADIENT BACKGROUND
    Replicates WhatsApp's signature diagonal gradient:
    - Start: #075E54 (darkest teal)
    - Mid: #128C7E (dark teal)
    - End: #25D366 (bright WhatsApp green)
    Angle 135° gives a top-left to bottom-right diagonal feel.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="135"
        android:startColor="@color/wa_darkest_teal"
        android:centerColor="@color/wa_dark_teal"
        android:endColor="@color/wa_green"
        android:type="linear" />
</shape>
