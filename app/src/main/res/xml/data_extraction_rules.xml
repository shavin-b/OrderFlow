<?xml version="1.0" encoding="utf-8"?>
<!--
    DATA EXTRACTION RULES (Android 12+ / API 31+)
    Controls what data is included in cloud backups and device-to-device transfers.
    We exclude SharedPreferences because they contain sensitive settings
    (auth state, cooldown configs) that should not be transferred to another device.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude all SharedPreferences from cloud backup -->
        <exclude domain="sharedpref" path="." />
        <!-- Exclude database files — Firebase is the source of truth -->
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <!-- Exclude all SharedPreferences from device-to-device transfers -->
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
