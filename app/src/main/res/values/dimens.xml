<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
         SPACING SYSTEM
         All margins and paddings use these tokens.
         Based on an 8dp grid (standard Material Design).
         ============================================================ -->
    <dimen name="spacing_xxs">2dp</dimen>
    <dimen name="spacing_xs">4dp</dimen>
    <dimen name="spacing_sm">8dp</dimen>
    <dimen name="spacing_md">12dp</dimen>
    <dimen name="spacing_base">16dp</dimen>
    <dimen name="spacing_lg">20dp</dimen>
    <dimen name="spacing_xl">24dp</dimen>
    <dimen name="spacing_xxl">32dp</dimen>
    <dimen name="spacing_xxxl">48dp</dimen>
    <dimen name="spacing_huge">64dp</dimen>

    <!-- ============================================================
         CORNER RADIUS SYSTEM
         MD3 uses a defined shape token system.
         ============================================================ -->
    <dimen name="radius_none">0dp</dimen>
    <dimen name="radius_extra_small">4dp</dimen>
    <dimen name="radius_small">8dp</dimen>
    <dimen name="radius_medium">12dp</dimen>
    <dimen name="radius_large">16dp</dimen>
    <dimen name="radius_extra_large">24dp</dimen>
    <dimen name="radius_full">50dp</dimen>

    <!-- ============================================================
         CARD DIMENSIONS
         ============================================================ -->
    <dimen name="card_padding">16dp</dimen>
    <dimen name="card_elevation">2dp</dimen>
    <dimen name="card_elevation_pressed">6dp</dimen>
    <dimen name="card_corner_radius">@dimen/radius_medium</dimen>
    <dimen name="card_margin_horizontal">16dp</dimen>
    <dimen name="card_margin_vertical">6dp</dimen>

    <!-- ============================================================
         ICON SIZES
         ============================================================ -->
    <dimen name="icon_size_xs">16dp</dimen>
    <dimen name="icon_size_sm">20dp</dimen>
    <dimen name="icon_size_md">24dp</dimen>
    <dimen name="icon_size_lg">32dp</dimen>
    <dimen name="icon_size_xl">48dp</dimen>
    <dimen name="icon_size_xxl">64dp</dimen>

    <!-- ============================================================
         TYPOGRAPHY
         Sizes follow Material Design 3 type scale.
         ============================================================ -->
    <dimen name="text_size_xs">10sp</dimen>
    <dimen name="text_size_sm">12sp</dimen>
    <dimen name="text_size_body">14sp</dimen>
    <dimen name="text_size_body_lg">16sp</dimen>
    <dimen name="text_size_subtitle">18sp</dimen>
    <dimen name="text_size_title">20sp</dimen>
    <dimen name="text_size_headline">24sp</dimen>
    <dimen name="text_size_display">32sp</dimen>

    <!-- ============================================================
         COMPONENT DIMENSIONS
         ============================================================ -->

    <!-- Toolbar -->
    <dimen name="toolbar_height">56dp</dimen>
    <dimen name="toolbar_elevation">4dp</dimen>

    <!-- Bottom Navigation -->
    <dimen name="bottom_nav_height">64dp</dimen>
    <dimen name="bottom_nav_elevation">8dp</dimen>

    <!-- FAB -->
    <dimen name="fab_margin">16dp</dimen>
    <dimen name="fab_size">56dp</dimen>

    <!-- Buttons -->
    <dimen name="button_height">48dp</dimen>
    <dimen name="button_corner_radius">@dimen/radius_medium</dimen>
    <dimen name="button_padding_horizontal">24dp</dimen>

    <!-- Text Fields / Inputs -->
    <dimen name="input_corner_radius">@dimen/radius_small</dimen>

    <!-- List Items -->
    <dimen name="list_item_height_sm">56dp</dimen>
    <dimen name="list_item_height_md">72dp</dimen>
    <dimen name="list_item_height_lg">88dp</dimen>
    <dimen name="list_item_padding_horizontal">@dimen/spacing_base</dimen>
    <dimen name="list_item_padding_vertical">@dimen/spacing_md</dimen>

    <!-- Avatar / Profile Circle -->
    <dimen name="avatar_size_sm">32dp</dimen>
    <dimen name="avatar_size_md">40dp</dimen>
    <dimen name="avatar_size_lg">56dp</dimen>

    <!-- Badge (status chips on log entries) -->
    <dimen name="badge_padding_horizontal">8dp</dimen>
    <dimen name="badge_padding_vertical">3dp</dimen>
    <dimen name="badge_corner_radius">@dimen/radius_full</dimen>

    <!-- Dashboard stat cards -->
    <dimen name="stat_card_height">100dp</dimen>
    <dimen name="stat_number_size">28sp</dimen>

    <!-- Empty state illustrations -->
    <dimen name="empty_state_icon_size">120dp</dimen>
    <dimen name="empty_state_lottie_size">200dp</dimen>

    <!-- Divider -->
    <dimen name="divider_thickness">1dp</dimen>

    <!-- Screen horizontal padding (consistent edge-to-edge margins) -->
    <dimen name="screen_horizontal_padding">16dp</dimen>
    <dimen name="screen_vertical_padding">16dp</dimen>

    <!-- App Logo on splash/login -->
    <dimen name="logo_size_splash">80dp</dimen>
    <dimen name="logo_size_login">60dp</dimen>

    <!-- Permission Wizard step icons -->
    <dimen name="wizard_step_icon_size">72dp</dimen>
    <dimen name="wizard_step_icon_bg_size">96dp</dimen>

</resources>
