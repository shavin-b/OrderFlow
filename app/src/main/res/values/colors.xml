    <!-- ============================================================
         MATERIAL DESIGN 3 — LIGHT MODE COLOR ROLES
         MD3 defines a set of "color roles" (primary, secondary, etc.)
         Each role has a pair: the color itself + "on" color (text/icons on it).
         ============================================================ -->

    <!-- Primary: WhatsApp darkest teal — used for AppBar, primary buttons, FAB -->
    <color name="md3_primary">#075E54</color>
    <color name="md3_on_primary">#FFFFFF</color>
    <color name="md3_primary_container">#A8F5DF</color>
    <color name="md3_on_primary_container">#002117</color>

    <!-- Primary Fixed: used for tonal surfaces -->
    <color name="md3_primary_fixed">#A8F5DF</color>
    <color name="md3_primary_fixed_dim">#6DD8C1</color>
    <color name="md3_on_primary_fixed">#002117</color>
    <color name="md3_on_primary_fixed_variant">#004D3A</color>

