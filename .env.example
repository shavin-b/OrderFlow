# ============================================================
# OrderFlow Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# ----- Server -----
SERVER_PORT=8080

# ----- Database -----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=orderflow
DB_USERNAME=orderflow_user
DB_PASSWORD=change_me_strong_password
MYSQL_ROOT_PASSWORD=change_me_root_password

# ----- WhatsApp Cloud API -----
# Obtain from Meta for Developers → Your App → WhatsApp → API Setup
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456
WHATSAPP_VERIFY_TOKEN=a_random_secret_string_you_choose
WHATSAPP_APP_SECRET=your_meta_app_secret_here

# ----- Security -----
# Comma-separated list of valid API keys for inbound REST calls
# Generate with: openssl rand -hex 32
API_KEYS=replace_with_strong_random_api_key_1,replace_with_strong_random_api_key_2

# ----- Spring Profile -----
SPRING_PROFILES_ACTIVE=production
