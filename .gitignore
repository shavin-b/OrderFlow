# ============================================================
# .gitignore for OrderFlow Android Project
# ============================================================

# Gradle
.gradle/
build/
gradle-app.setting
!gradle-wrapper.jar
!gradle-wrapper.properties

# Android Studio / IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
captures/
.externalNativeBuild/
.cxx/
local.properties

# Build outputs
app/build/

# Firebase — NEVER commit google-services.json to public repos
# (Contains API keys — add your own from the Firebase Console)
# Uncomment the line below for open-source projects:
# app/google-services.json

# Keystore files — NEVER commit to version control
*.jks
*.keystore
keystore.properties

# ProGuard mapping
app/out/
mapping/

# OS-generated files
.DS_Store
Thumbs.db
desktop.ini

# Log files
*.log
